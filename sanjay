<body><h1>🏏 IPL Auction 2026</h1><h2 id="player"></h2>
<h3 id="role"></h3>
<h3 id="bid"></h3>
<h3 id="team"></h3><div id="buttons"></div><button onclick="sell()">Sell Player</button>

<h2>Teams Budget</h2>
<ul id="teams"></ul><script>
const socket = io();

const teamNames = ["CSK","MI","RCB","KKR","SRH","DC","PBKS","RR","GT","LSG"];

const btnDiv = document.getElementById('buttons');
teamNames.forEach(t => {
  const btn = document.createElement('button');
  btn.innerText = t + " Bid";
  btn.onclick = () => bid(t);
  btnDiv.appendChild(btn);
});

socket.on('update', (data) => {
  document.getElementById('player').innerText = data.currentPlayer.name;
  document.getElementById('role').innerText =
    "Role: " + data.currentPlayer.role + " | " + data.currentPlayer.country;
  document.getElementById('bid').innerText = 'Bid: ' + data.currentPlayer.currentBid + ' Cr';
  document.getElementById('team').innerText = 'Leading: ' + (data.currentPlayer.highestBidder || 'None');

  let teamList = '';
  for (let t in data.teams) {
    teamList += `<li>${t}: ${data.teams[t].toFixed(1)} Cr</li>`;
  }
  document.getElementById('teams').innerHTML = teamList;
});

function bid(team) {
  socket.emit('bid', team);
}

function sell() {
  socket.emit('sell');
}
</script></body>
