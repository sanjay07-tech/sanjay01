// Load players from JSON let players = JSON.parse(fs.readFileSync('players.json')); let index = 0;

function getNextPlayer() { if (index >= players.length) index = 0; let p = players[index++]; return { name: p.name, role: p.role, country: p.country, basePrice: p.base, currentBid: p.base, highestBidder: null }; }

let currentPlayer = getNextPlayer();

